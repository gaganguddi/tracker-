# Google Cloud OAuth & API Configuration
# Copy this file to .env and fill in your real values
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
VITE_GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# App Security (Master Password - keep this secret!)
VITE_MASTER_PASSWORD=your_master_password_here
